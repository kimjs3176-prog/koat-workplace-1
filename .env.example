# 서무비서 환경변수 예시 — 복사해 .env 로 쓰거나 배포 플랫폼(Vercel 등)에 등록하세요. 실제 값은 저장소에 넣지 마세요.

# 관리자 토큰: 내규 업로드·기관 절차·기관 설정 저장에 필요(길고 추측하기 어려운 값)
REG_UPLOAD_TOKEN=

# 읽기 전용 배포(Vercel 등)에서 화면 저장을 저장소 커밋으로 반영할 때
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

# 기관 설정 파일 위치를 바꿀 때(기본: secretary/config.json)
# SECRETARY_CONFIG=/data/config.json

# 선택: AI 비서 기능(영수증 사진 인식·상황 이해). 키가 있는 쪽을 자동으로 씁니다(둘 다 있으면 Claude).
#   키가 없으면 영수증은 직접 입력, 상황 이해는 등록 절차 매칭만으로 동작합니다.
ANTHROPIC_API_KEY=
# SECRETARY_AI_PROVIDER=claude        # claude | gemini 고정
# SECRETARY_AI_MODEL=claude-opus-5-5  # 모델 바꿀 때(Gemini 는 GEMINI_MODEL, 기본 gemini-2.5-flash)
# SECRETARY_AI_RATE=40                # IP 당 10분에 허용할 AI 요청 수(기관 키 남용 방지)

# 선택: 기관 집단 지식(익명 통계) 저장소 — 읽기 전용 배포(Vercel)는 Upstash Redis(Vercel KV) 연결 시 켜짐.
#   쓰기 가능한 내부 서버는 설정 없이 secretary/insights.json 에 저장합니다.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SECRETARY_INSIGHTS_FILE=/data/insights.json

# 선택: 관련 조문 찾기의 의미 검색(Gemini 임베딩) — 색인은 scripts/build_embeddings.py 로 생성
GEMINI_API_KEY=
# SEMANTIC_MIN_SCORE=0.5

# 선택: 업로드 최대 크기(MB), 원본 PDF 주소 접두어, 다른 도메인에서 API 를 부를 때 허용 출처(쉼표 구분)
# REG_UPLOAD_MAX_MB=40
# REG_PDF_BASE_URL=
# ALLOWED_ORIGINS=https://secretary.example.go.kr
# EMBED_MODEL=text-embedding-004      # 의미 검색 임베딩 모델(색인 생성·질의 공통)

# 기관 GitHub Enterprise 를 쓰면 API 주소 지정
# GITHUB_API=https://github.example.go.kr/api/v3

# 로컬 실행 포트(run_local.py)
# PORT=5100
